{
    "realm": "coworking-booking",
    "enabled": true,
    "displayName": "CoworkingBooking",
    "registrationAllowed": false,
    "loginWithEmailAllowed": true,
    "duplicateEmailsAllowed": false,
    "resetPasswordAllowed": true,
    "roles": {
        "realm": [
            {
                "name": "user",
                "description": "Default user role"
            },
            {
                "name": "admin",
                "description": "Administrator"
            }
        ]
    },
    "clientScopes": [
        {
            "name": "coworking-booking-api-audience",
            "description": "Adds the API audience to access tokens",
            "protocol": "openid-connect",
            "attributes": {
                "include.in.token.scope": "true",
                "display.on.consent.screen": "false"
            },
            "protocolMappers": [
                {
                    "name": "coworking-booking-api-audience-mapper",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "consentRequired": false,
                    "config": {
                        "included.client.audience": "coworking-booking-api",
                        "id.token.claim": "false",
                        "access.token.claim": "true",
                        "introspection.token.claim": "true"
                    }
                },
                {
                    "name": "realm roles",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-realm-role-mapper",
                    "consentRequired": false,
                    "config": {
                        "user.attribute": "foo",
                        "access.token.claim": "true",
                        "claim.name": "realm_access.roles",
                        "jsonType.label": "String",
                        "multivalued": "true"
                    }
                }
            ]
        }
    ],
    "clients": [
        {
            "clientId": "coworking-booking-api",
            "name": "Coworking Booking API",
            "enabled": true,
            "protocol": "openid-connect",
            "publicClient": true,
            "bearerOnly": false,
            "standardFlowEnabled": false,
            "implicitFlowEnabled": false,
            "directAccessGrantsEnabled": true,
            "defaultClientScopes": [
                "web-origins",
                "acr",
                "roles",
                "profile",
                "email",
                "coworking-booking-api-audience"
            ]
        }
    ],
    "users": [
        {
            "username": "admin",
            "enabled": true,
            "email": "admin@example.com",
            "emailVerified": true,
            "firstName": "Admin",
            "lastName": "User",
            "credentials": [
                {
                    "type": "password",
                    "value": "admin123",
                    "temporary": false
                }
            ],
            "realmRoles": [
                "admin",
                "user"
            ]
        },
        {
            "username": "john",
            "enabled": true,
            "email": "john@example.com",
            "emailVerified": true,
            "firstName": "John",
            "lastName": "Doe",
            "credentials": [
                {
                    "type": "password",
                    "value": "123456",
                    "temporary": false
                }
            ],
            "realmRoles": [
                "user"
            ]
        }
    ]
}
